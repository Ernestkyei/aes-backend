// ======================================================
// USER MODELS
// ======================================================

model User {
  id              String          @id @default(cuid())
  email           String          @unique
  password        String
  firstName       String
  lastName        String
  phoneNumber     String?
  role            UserRole        @default(APPLICANT)
  isActive        Boolean         @default(true)
  lastLogin       DateTime?
  
  // Relations
  subscription    Subscription?   
  applications    Application[]
  paymentCodes    PaymentCode[]
  documents       Document[]
  activityLogs    ActivityLog[]
  adminNotes      AdminNote[]
  adminActions    AdminActionLog[]  
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("users")
}

// ======================================================
// PAYMENT CODE MODELS
// ======================================================

model PaymentCode {
  id              String          @id @default(cuid())
  code            String          @unique
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  subscriptionId  String          @unique
  subscription    Subscription?   @relation(fields: [subscriptionId], references: [id])
  
  isValid         Boolean         @default(true)
  usedAt          DateTime?
  expiresAt       DateTime
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([code])
  @@index([userId])
  @@map("payment_codes")
}

// ======================================================
// ACTIVITY LOG MODELS
// ======================================================

model ActivityLog {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id])
  
  action          String
  details         String?
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@map("activity_logs")
}