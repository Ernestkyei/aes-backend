model EducationSubject {
  id                String          @id @default(cuid())
  educationRecordId String
  name              String
  grade             String?
  score             Float?
  educationRecord   EducationRecord @relation(fields: [educationRecordId], references: [id])

  @@map("education_subjects")
}

model EducationRecord {
  id              String             @id @default(cuid())
  applicationId   String             @unique
  highSchool      String
  graduationYear  String
  wassceAggregate String?
  gpa             Float?
  gpaScale        Float?             @default(4.0)
  classRank       String?
  classSize       Int?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  application     Application        @relation(fields: [applicationId], references: [id])
  subjects        EducationSubject[]

  @@map("education_records")
}
